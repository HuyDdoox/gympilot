# Environment variables for GymPilot

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (PostgreSQL 16)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gympilot?schema=public"

# JWT Authentication
JWT_SECRET=supersecretjwtkey_gympilot_development_only_2026
JWT_REFRESH_SECRET=supersecretjwtrefreshkey_gympilot_development_only_2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
